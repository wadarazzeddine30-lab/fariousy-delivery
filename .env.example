# ==============================================================================
# FARIOUSY DELIVERY — Production Environment Variables (.env)
# Domain: https://app.fariousy.com
# Node.js VPS Server + Supabase Database
# ==============================================================================

# Server Network & Runtime
PORT=3000
NODE_ENV=production
APP_URL=https://app.fariousy.com

# Supabase Database Configuration
# Both VITE_ prefixed (client accessible) and standard server-side variables
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Server-Side Only Supabase Service Role Key (Keep Private, Never expose to client)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Internal API Secret for Server-to-Server and Webhook Gateway
FARIOUSY_API_SECRET=your_super_secret_internal_token_here

# Optional: Google Gemini API Key
GEMINI_API_KEY=""
